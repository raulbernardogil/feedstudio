# Copy to .env (root, for docker compose) or backend/.env (local development).
# All backend variables use the FEEDSTUDIO_ prefix.

# --- docker compose ---
POSTGRES_PASSWORD=change-me

# --- backend ---
FEEDSTUDIO_ENVIRONMENT=development
# SQLite for local development; PostgreSQL in docker compose:
# FEEDSTUDIO_DATABASE_URL=postgresql+psycopg://feedstudio:change-me@localhost:5432/feedstudio
FEEDSTUDIO_DATABASE_URL=sqlite:///./data/feedstudio.db
FEEDSTUDIO_STORAGE_DIR=./data/storage
# 'thread' = in-process background jobs (any OS); 'rq' = Redis workers (Linux/Docker)
FEEDSTUDIO_JOB_BACKEND=thread
FEEDSTUDIO_REDIS_URL=redis://localhost:6379/0
# Base used to build stable public feed URLs (what ad platforms download)
FEEDSTUDIO_PUBLIC_BASE_URL=http://localhost:8000
FEEDSTUDIO_CORS_ORIGINS=["http://localhost:5173"]
# If set, every /api call requires "Authorization: Bearer <token>". Public /f/ URLs stay open.
FEEDSTUDIO_API_TOKEN=

# Limits & safety
FEEDSTUDIO_MAX_FEED_MB=200
FEEDSTUDIO_MAX_UPLOAD_MB=200
FEEDSTUDIO_MAX_ITEMS=1000000
FEEDSTUDIO_FETCH_TIMEOUT_SECONDS=60
# Plain-HTTP feed URLs are refused unless enabled
FEEDSTUDIO_ALLOW_HTTP_SOURCES=false
# NEVER enable in production: disables SSRF protection against private networks
FEEDSTUDIO_ALLOW_PRIVATE_NETWORKS=false
FEEDSTUDIO_SNAPSHOT_RETENTION=5
FEEDSTUDIO_PREVIEW_MAX_SCAN=200000
# Block publication if the new version has more than this ratio fewer items
FEEDSTUDIO_PUBLISH_DROP_THRESHOLD=0.5
